# Claude. With a key set, every agent runs on Claude; without one, demo mode (offline outputs).
ANTHROPIC_API_KEY=
# CA_MODEL=claude-opus-5-5
# CA_WEB_RESEARCH=1          # researcher uses Claude's web search for live trends (live mode)

# Trend feeds (public, no keys): Reddit top-of-week + Google Trends RSS
# CA_LIVE_TRENDS=1
# CA_SUBREDDITS=marketing,socialmedia,Entrepreneur

# Folder the video editor watches. Point it at a Google Drive for Desktop folder
# so videos uploaded from your phone's Drive app land here automatically.
# CA_INBOX_DIR=/Users/you/Google Drive/My Drive/Content Inbox

# Alerts ("script ready, go film", "drafts ready to approve")
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Captions font (any installed font; falls back automatically)
# CA_CAPTION_FONT=Inter Black
